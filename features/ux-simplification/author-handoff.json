  "addressed": [
    {
      "id": "UX-R1",
      "priority": "P1",
      "classification": "prototype-consent-context",
      "status": "addressed_by_author",
      "delta": "Согласие сбрасывается после create, при начале нового пакета и изменении имени/состава. Новая форма unchecked, кнопка disabled до явного согласия.",
      "evidence": [
        "UX-R1 consent reset after create",
        "UX-R1 new context unchecked",
        "UX-R1 new context submit disabled",
        "UX-R1 name change invalidates consent",
        "UX-R1 clip change invalidates consent"
      ]
    },
    {
      "id": "UX-R2",
      "priority": "P2",
      "classification": "prototype-state-preservation",
      "status": "addressed_by_author",
      "delta": "Черновик/сохранённый CTA и URL хранятся вне DOM, музыка — отдельно для выбранного клипа. Перерисовка, Play и clip selection не возвращают none/empty.",
      "evidence": [
        "UX-R2 saved CTA survives Play render",
        "UX-R2 saved CTA survives clip selection",
        "UX-R2 music draft survives Play"
      ]
    },
    {
      "id": "UX-R3",
      "priority": "P2",
      "classification": "prototype-native-validation-focus",
      "status": "addressed_by_author",
      "delta": "Native invalid capture раскрывает ancestor details, фокусирует фактически невалидное поле и показывает validationMessage; проверка required/range/step не обходится.",
      "evidence": [
        "UX-R3 invalid ancestor revealed",
        "UX-R3 invalid field focused",
        "UX-R3 native range invalid blocks save",
        "UX-R3 native invalid 2.5",
        "UX-R3 native invalid 1441"
      ]
    },
    {
      "id": "UX-R4",
      "priority": "P2",
      "classification": "prototype-guest-pack-lifecycle",
      "status": "addressed_by_author",
      "delta": "Созданные пакеты сохраняются в demo-модели независимо от панели; повторное Поделиться показывает created/sent/revoked и допустимые send/copy/revoke.",
      "evidence": [
        "UX-R4 old pack copy returns",
        "UX-R4 old pack revoke returns",
        "UX-R4 revoke persists",
        "UX-R4 revoked pack has no copy/revoke"
      ]
    },
    {
      "id": "UX-R5",
      "priority": "P2",
      "classification": "design-function-preservation",
      "status": "addressed_by_author",
      "delta": "В guest-контексте доступны несколько ready-клипов. Extra referral form внутри закрытых дополнительных показателей/ссылок статистики; музыка имеет контекстное demo-preview/stop без аудио/сети.",
      "evidence": [
        "UX-R5 partial only ready guest clips",
        "UX-R5 created multi-clip pack",
        "UX-R5 music preview contextual",
        "UX-R5 extra referral code in context"
      ]
    }
  ],
